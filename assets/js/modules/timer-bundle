/* v74 production timer bundle
   Generated from timer-core.js + timer-service.js + timer-controller.js.
   Keeping timer modules in one production request prevents partial/stale module loading.
*/
(() => {
  'use strict';

  const MODES=Object.freeze({
    IDLE:'idle',
    WORKING:'working',
    PAUSED:'paused',
    BREAK:'break'
  });

  const TRANSITIONS=Object.freeze({
    idle:new Set(['idle','working','break']),
    working:new Set(['working','paused','idle']),
    paused:new Set(['paused','working','idle']),
    break:new Set(['break','idle','working'])
  });

  function canTransition(from,to){
    return Boolean(TRANSITIONS[from]?.has(to));
  }

  function closedIntervalSeconds(intervals){
    let seconds=0;
    (Array.isArray(intervals)?intervals:[]).forEach(interval=>{
      const start=Number(interval?.start);
      const end=interval?.end==null ? null : Number(interval.end);
      if(!Number.isFinite(start) || !Number.isFinite(end) || end<=start) return;
      seconds += Math.max(0,Math.floor((end-start)/1000));
    });
    return Math.max(0,Math.round(seconds));
  }

  function nextLocalMidnightMs(ms){
    const d=new Date(Number(ms)||Date.now());
    d.setHours(24,0,0,0);
    return d.getTime();
  }

  function splitRangeAtLocalMidnights(startMs,endMs){
    const start=Number(startMs);
    const end=Number(endMs);
    if(!Number.isFinite(start) || !Number.isFinite(end) || end<=start) return [];

    const out=[];
    let cursor=start;
    while(cursor<end){
      const boundary=nextLocalMidnightMs(cursor);
      const partEnd=Math.min(boundary,end);
      out.push({start:cursor,end:partEnd});
      cursor=partEnd;
    }
    return out;
  }

  function inferMode(state){
    if(state?.breakState) return MODES.BREAK;
    if(state?.activeSessionId) return state?.isWorking ? MODES.WORKING : MODES.PAUSED;
    return MODES.IDLE;
  }

  function validateState(state){
    const mode=inferMode(state);
    if(mode===MODES.WORKING){
      return Boolean(state?.activeSessionId && Number.isFinite(Number(state?.workStart)));
    }
    if(mode===MODES.PAUSED){
      return Boolean(state?.activeSessionId && !state?.workStart);
    }
    if(mode===MODES.BREAK){
      return Boolean(state?.breakState);
    }
    return !state?.activeSessionId && !state?.isWorking;
  }

  window.ProductivityTimerCore={
    MODES,
    TRANSITIONS,
    canTransition,
    closedIntervalSeconds,
    nextLocalMidnightMs,
    splitRangeAtLocalMidnights,
    inferMode,
    validateState
  };
})();

(() => {
  'use strict';

  const Core=window.ProductivityTimerCore;
  if(!Core) throw new Error('ProductivityTimerCore gerekli');

  function makeId(prefix='s',now=Date.now()){
    return prefix+now+'_'+Math.random().toString(36).slice(2,7);
  }

  function createSession({
    now=Date.now(),
    name='Oturum',
    subject='Genel',
    targetSeconds=null,
    seedTodoText=null
  }={}){
    return {
      id:makeId('s',now),
      name,
      subject:(subject||'Genel').trim() || 'Genel',
      createdAt:now,
      startedAt:now,
      endedAt:null,
      workIntervals:[{start:now,end:null}],
      hidden:false,
      duration:0,
      distractions:0,
      distractionCategories:{},
      todos:seedTodoText
        ? [{id:'t'+now+'seed',text:String(seedTodoText).trim().slice(0,80),done:false,linkedTaskId:null}]
        : [],
      targetSeconds:Number(targetSeconds)>0 ? Number(targetSeconds) : null,
      targetReached:false,
      breakNotified:false,
      updatedAt:now,
      milestonesHit:[]
    };
  }

  function hasOpenInterval(session){
    const list=Array.isArray(session?.workIntervals) ? session.workIntervals : [];
    return list.some(x=>Number.isFinite(Number(x?.start)) && x?.end==null);
  }

  function closeOpenInterval(session,at=Date.now()){
    if(!session) return false;
    if(!Array.isArray(session.workIntervals)) session.workIntervals=[];
    let changed=false;
    for(let i=session.workIntervals.length-1;i>=0;i--){
      const interval=session.workIntervals[i];
      if(interval?.end==null && Number.isFinite(Number(interval?.start))){
        interval.end=Math.max(Number(interval.start),Number(at)||Date.now());
        changed=true;
        break;
      }
    }
    if(changed){
      session.duration=Core.closedIntervalSeconds(session.workIntervals);
      session.updatedAt=Number(at)||Date.now();
    }
    return changed;
  }

  function openInterval(session,at=Date.now()){
    if(!session) return false;
    if(!Array.isArray(session.workIntervals)) session.workIntervals=[];
    if(hasOpenInterval(session)) return false;
    const start=Number(at)||Date.now();
    session.workIntervals.push({start,end:null});
    session.updatedAt=start;
    return true;
  }

  function pauseSession(session,at=Date.now()){
    if(!session) return null;
    closeOpenInterval(session,at);
    session.duration=Core.closedIntervalSeconds(session.workIntervals);
    session.updatedAt=Number(at)||Date.now();
    return session;
  }

  function resumeSession(session,at=Date.now()){
    if(!session) return null;
    openInterval(session,at);
    session.updatedAt=Number(at)||Date.now();
    return session;
  }

  function finishSession(session,at=Date.now()){
    if(!session) return null;
    closeOpenInterval(session,at);
    session.duration=Core.closedIntervalSeconds(session.workIntervals);
    if(!session.endedAt) session.endedAt=Number(at)||Date.now();
    session.updatedAt=Number(at)||Date.now();
    return session;
  }

  function createMidnightContinuation(previous,startMs){
    const session=createSession({
      now:startMs,
      name:previous?.name || 'Oturum',
      subject:previous?.subject || 'Genel',
      targetSeconds:previous?.targetSeconds || null
    });
    session.continuedFromMidnight=true;
    return session;
  }

  window.ProductivityTimerService={
    createSession,
    createMidnightContinuation,
    hasOpenInterval,
    openInterval,
    closeOpenInterval,
    pauseSession,
    resumeSession,
    finishSession
  };
})();

(() => {
  'use strict';

  const Core=window.ProductivityTimerCore;
  const Service=window.ProductivityTimerService;

  if(!Core) throw new Error('ProductivityTimerCore gerekli');
  if(!Service) throw new Error('ProductivityTimerService gerekli');

  function requireFn(deps,name){
    if(typeof deps?.[name]!=='function'){
      throw new Error(`TimerController dependency eksik: ${name}`);
    }
    return deps[name];
  }

  function create(deps={}){
    const now=typeof deps.now==='function' ? deps.now : ()=>Date.now();

    const todayKey=requireFn(deps,'todayKey');
    const getTodaySessionCount=requireFn(deps,'getTodaySessionCount');
    const addSession=requireFn(deps,'addSession');
    const getActiveSession=requireFn(deps,'getActiveSession');
    const getSessionDateKey=requireFn(deps,'getSessionDateKey');
    const recomputeSessionDay=requireFn(deps,'recomputeSessionDay');
    const transitionMode=requireFn(deps,'transitionMode');
    const persist=requireFn(deps,'persist');

    function start({subject='',targetMinutes=null,seedTodoText=null}={}){
      deps.ensureReady?.();
      if(deps.isBreakActive?.()) deps.stopBreak?.();

      const startedAt=now();
      const cleanSubject=String(subject||'').trim();
      if(cleanSubject) deps.rememberSubject?.(cleanSubject);

      const session=Service.createSession({
        now:startedAt,
        name:'Oturum ' + (Number(getTodaySessionCount())+1),
        subject:cleanSubject || 'Genel',
        targetSeconds:Number(targetMinutes)>0 ? Number(targetMinutes)*60 : null,
        seedTodoText
      });

      const sessionDate=todayKey();
      addSession(sessionDate,session);
      recomputeSessionDay(sessionDate);

      const transitioned=transitionMode(Core.MODES.WORKING,{
        sessionId:session.id,
        sessionDate,
        runningSince:startedAt,
        ownerId:deps.ownerId?.() || null
      });

      if(!transitioned){
        throw new Error('Timer WORKING durumuna geçirilemedi');
      }

      deps.touchHeartbeat?.();
      persist({force:true});

      return {session,sessionDate,startedAt};
    }

    function pause(){
      const completedList=deps.beforePause?.() || [];
      const session=getActiveSession();

      if(!session){
        return {session:null,completedList,pausedAt:null};
      }

      const pausedAt=now();
      Service.pauseSession(session,pausedAt);
      recomputeSessionDay(getSessionDateKey(session.id) || todayKey());

      const transitioned=transitionMode(Core.MODES.PAUSED,{
        sessionId:session.id
      });

      if(!transitioned){
        throw new Error('Timer PAUSED durumuna geçirilemedi');
      }

      persist();
      return {session,completedList,pausedAt};
    }

    function resume(){
      deps.ensureReady?.();
      const session=getActiveSession();
      if(!session) return {session:null,resumedAt:null};

      const resumedAt=now();
      Service.resumeSession(session,resumedAt);

      const transitioned=transitionMode(Core.MODES.WORKING,{
        sessionId:session.id,
        runningSince:resumedAt,
        ownerId:deps.ownerId?.() || null
      });

      if(!transitioned){
        throw new Error('Timer WORKING durumuna geri geçirilemedi');
      }

      deps.touchHeartbeat?.();
      persist();

      return {session,resumedAt};
    }

    function finish(){
      const wasWorking=Boolean(deps.isWorking?.());
      const completedList=wasWorking ? (deps.beforeFinish?.() || []) : [];
      const session=getActiveSession();
      let endedAt=null;

      if(session){
        endedAt=now();
        Service.finishSession(session,endedAt);
        recomputeSessionDay(getSessionDateKey(session.id) || todayKey());
      }

      const transitioned=transitionMode(Core.MODES.IDLE);
      if(!transitioned){
        throw new Error('Timer IDLE durumuna geçirilemedi');
      }

      persist();
      return {session,completedList,endedAt};
    }

    return Object.freeze({
      start,
      pause,
      resume,
      finish
    });
  }

  window.ProductivityTimerController={create};
})();
